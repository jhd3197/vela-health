{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "maxItems": 1000,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "name",
      "color",
      "target",
      "days"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,100}$"
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60
      },
      "color": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
      },
      "target": {
        "type": "integer",
        "minimum": 1,
        "maximum": 7
      },
      "days": {
        "type": "object",
        "maxProperties": 40000,
        "propertyNames": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "additionalProperties": {
          "const": true
        }
      }
    }
  }
}
